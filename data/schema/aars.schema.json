{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "title",
      "trigger",
      "links",
      "expected",
      "actual",
      "why",
      "change",
      "change_pr",
      "owner",
      "status",
      "thread"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^aar-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "title": {
        "type": "string",
        "maxLength": 120
      },
      "trigger": {
        "type": "string",
        "enum": [
          "revert",
          "failed-deploy",
          "post-deploy-check",
          "ci-main",
          "ci-pr",
          "data-correction",
          "block-upheld",
          "incident"
        ]
      },
      "links": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prs",
          "runs",
          "commits",
          "chat"
        ],
        "properties": {
          "prs": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d+$"
            }
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            }
          },
          "chat": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "cite"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "cite": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(pr:\\d+|run:\\d+|commit:[0-9a-f]{7,40}|chat:[a-z0-9-]+|runlog:[0-9a-z-]+|file:[A-Za-z0-9_./-]+)$"
            }
          }
        }
      },
      "actual": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "cite"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "cite": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(pr:\\d+|run:\\d+|commit:[0-9a-f]{7,40}|chat:[a-z0-9-]+|runlog:[0-9a-z-]+|file:[A-Za-z0-9_./-]+)$"
            }
          }
        }
      },
      "why": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "cite"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "cite": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(pr:\\d+|run:\\d+|commit:[0-9a-f]{7,40}|chat:[a-z0-9-]+|runlog:[0-9a-z-]+|file:[A-Za-z0-9_./-]+)$"
            }
          }
        }
      },
      "change": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "cite"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "cite": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(pr:\\d+|run:\\d+|commit:[0-9a-f]{7,40}|chat:[a-z0-9-]+|runlog:[0-9a-z-]+|file:[A-Za-z0-9_./-]+)$"
            }
          }
        }
      },
      "change_pr": {
        "type": "integer"
      },
      "owner": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core",
          "CEO",
          "Scoutmaster",
          "Critic",
          "Advocate",
          "Librarian",
          "Comms",
          "Gamemaster"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "closed"
        ]
      },
      "fix_pr": {
        "type": "integer"
      },
      "closed": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "thread": {
        "type": "string"
      },
      "repeat_of": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
