{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "decision",
    "thread",
    "note",
    "levels",
    "events",
    "tables",
    "quality",
    "statuses",
    "achievements",
    "anti_gaming",
    "quests",
    "later_weeks"
  ],
  "properties": {
    "owner": {
      "type": "string",
      "enum": [
        "Gamemaster"
      ]
    },
    "decision": {
      "type": "string"
    },
    "thread": {
      "type": "string"
    },
    "note": {
      "type": "string",
      "maxLength": 400
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "xp"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 20
          },
          "xp": {
            "type": "integer"
          }
        }
      }
    },
    "events": {
      "type": "object"
    },
    "tables": {
      "type": "object"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_pct",
        "note"
      ],
      "properties": {
        "default_pct": {
          "type": "integer"
        },
        "note": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending",
        "approved",
        "rejected",
        "reversed"
      ],
      "properties": {
        "pending": {
          "type": "string",
          "maxLength": 160
        },
        "approved": {
          "type": "string",
          "maxLength": 160
        },
        "rejected": {
          "type": "string",
          "maxLength": 160
        },
        "reversed": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "rule",
          "event"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 30
          },
          "rule": {
            "type": "string",
            "maxLength": 120
          },
          "event": {
            "type": "string",
            "enum": [
              "pr_merged",
              "signoff",
              "block_upheld",
              "deploy_check",
              "ci_test_added",
              "aar_written",
              "aar_fix",
              "research_accepted",
              "pitch_shipped",
              "error_prevented",
              "regression_prevented"
            ]
          }
        }
      }
    },
    "anti_gaming": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "quests": {
      "type": "object"
    },
    "later_weeks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week2",
        "week3",
        "week4"
      ],
      "properties": {
        "week2": {
          "type": "string",
          "maxLength": 300
        },
        "week3": {
          "type": "string",
          "maxLength": 300
        },
        "week4": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
