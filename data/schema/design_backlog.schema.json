{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "idea",
      "why",
      "effort",
      "rank",
      "state"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "idea": {
        "type": "string",
        "maxLength": 120
      },
      "why": {
        "type": "string",
        "maxLength": 280
      },
      "effort": {
        "type": "string",
        "enum": [
          "S",
          "M",
          "L"
        ]
      },
      "rank": {
        "type": "integer"
      },
      "state": {
        "type": "string",
        "enum": [
          "backlog",
          "in-progress",
          "shipped",
          "dropped"
        ]
      },
      "shipped": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "ref": {
        "type": "string",
        "pattern": "^https://"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
