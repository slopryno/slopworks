{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "role",
      "topic",
      "takeaways",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "role": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core"
        ]
      },
      "topic": {
        "type": "string",
        "maxLength": 120
      },
      "takeaways": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 280
        }
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "idea": {
        "type": "string",
        "maxLength": 280
      },
      "pitch": {
        "type": "string"
      }
    }
  }
}
