{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "role",
      "kind",
      "question",
      "outcome",
      "finding",
      "evidence",
      "confidence",
      "status",
      "fresh_until"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "role": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core",
          "Scoutmaster",
          "Critic",
          "Advocate",
          "Librarian"
        ]
      },
      "kind": {
        "type": "string",
        "enum": [
          "rotation",
          "focused",
          "urgent"
        ]
      },
      "question": {
        "type": "string",
        "maxLength": 200
      },
      "outcome": {
        "type": "string",
        "enum": [
          "proposal",
          "finding",
          "no-change"
        ]
      },
      "finding": {
        "type": "string",
        "maxLength": 400
      },
      "facts": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 280
        }
      },
      "inferences": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 280
        }
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "confidence": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "verified",
          "reported",
          "hypothesis",
          "disproved",
          "stale"
        ]
      },
      "existing_work": {
        "type": "string",
        "maxLength": 280
      },
      "opportunity": {
        "type": "string",
        "maxLength": 280
      },
      "alternatives": {
        "type": "string",
        "maxLength": 280
      },
      "effort": {
        "type": "string",
        "enum": [
          "S",
          "M",
          "L"
        ]
      },
      "risks": {
        "type": "string",
        "maxLength": 280
      },
      "experiment": {
        "type": "string",
        "maxLength": 280
      },
      "success_metric": {
        "type": "string",
        "maxLength": 200
      },
      "recommendation": {
        "type": "string",
        "enum": [
          "pursue",
          "investigate",
          "defer",
          "reject"
        ]
      },
      "fresh_until": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "reader_feedback": {
        "type": "boolean"
      },
      "pitch": {
        "type": "string"
      }
    }
  }
}
