{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "kind",
      "status",
      "counts"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "daily",
          "weekly",
          "monthly",
          "backfill",
          "launch"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "ok",
          "skipped",
          "failed",
          "quiet"
        ]
      },
      "counts": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      },
      "x_reads": {
        "type": "integer"
      },
      "notes": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 280
        }
      },
      "pr": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
