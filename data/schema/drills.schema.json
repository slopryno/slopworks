{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "date", "drill", "by", "checked_by", "items"],
    "properties": {
      "id": {"type": "string", "pattern": "^d\\d{4}-\\d{2}-\\d{2}-[a-z]+$"},
      "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "drill": {"type": "string", "enum": ["re-derive", "close-the-loop", "resume-runbook"]},
      "by": {"type": "string"},
      "checked_by": {"type": "string"},
      "items": {"type": "array", "items": {"type": "object", "additionalProperties": false,
        "required": ["claim", "command", "value", "matched"],
        "properties": {"claim": {"type": "string", "maxLength": 200}, "command": {"type": "string", "maxLength": 200},
                       "value": {"type": "string", "maxLength": 80}, "matched": {"type": "boolean"}}}}
    }
  }
}
