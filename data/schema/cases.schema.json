{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "kind",
      "title",
      "summary",
      "shows",
      "steps",
      "outcome",
      "pr"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "real"
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 120
      },
      "summary": {
        "type": "string",
        "maxLength": 300
      },
      "shows": {
        "type": "string",
        "maxLength": 200
      },
      "steps": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "role",
            "text",
            "link"
          ],
          "properties": {
            "label": {
              "type": "string",
              "enum": [
                "verified",
                "hypothesis",
                "recommendation",
                "demo"
              ]
            },
            "role": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "maxLength": 240
            },
            "link": {
              "type": "string",
              "pattern": "^(\\.\\./(chat|arena|cases|challenges)/#[a-z0-9-]+|https://github\\.com/slopryno/slopworks/pull/\\d+)$"
            }
          }
        }
      },
      "outcome": {
        "type": "string",
        "maxLength": 200
      },
      "pr": {
        "type": "integer"
      },
      "idea": {
        "type": "string"
      }
    }
  }
}
