{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "demo",
      "title",
      "brief",
      "roles",
      "thread",
      "pr",
      "sections"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "demo": {
        "type": "boolean",
        "enum": [
          true
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 120
      },
      "brief": {
        "type": "string",
        "maxLength": 400
      },
      "roles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "thread": {
        "type": "string"
      },
      "pr": {
        "type": "integer"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "items"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "Problem definition",
                "Recommended approach",
                "Expected benefits",
                "Technical requirements",
                "Risks and constraints",
                "Proposed first experiment",
                "Suggested next steps"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "role",
                  "research"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "role": {
                    "type": "string"
                  },
                  "research": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
