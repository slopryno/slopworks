{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["_note", "timezone", "recurring_from", "recurring", "themes", "events"],
  "properties": {
    "_note": {"type": "string"},
    "timezone": {"type": "string", "enum": ["America/New_York"]},
    "recurring_from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "recurring": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schedule_id", "title", "owner", "type", "show"],
        "properties": {
          "schedule_id": {"type": "string"},
          "title": {"type": "string", "maxLength": 40},
          "owner": {"type": "string"},
          "type": {"type": "string", "enum": ["routine", "review", "research", "release"]},
          "show": {"type": "string", "enum": ["note", "grid", "agenda"]}
        }
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "maxLength": 40},
          "status": {"type": "string", "enum": ["placeholder", "scheduled", "done"]},
          "avatar_set": {"type": "string", "pattern": "^[a-z0-9]+$"},
          "switch_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "switch_off": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "live_from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "title", "owner", "type", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "title": {"type": "string", "maxLength": 60},
          "owner": {"type": "string"},
          "with": {"type": "array", "items": {"type": "string"}},
          "type": {"type": "string", "enum": ["routine", "review", "research", "release", "holiday-theme"]},
          "status": {"type": "string", "enum": ["done", "planned"]},
          "theme": {"type": "string"},
          "step": {"type": "string", "enum": ["plan", "design", "wording", "review", "ceo-yes"]},
          "note": {"type": "string", "maxLength": 160}
        }
      }
    }
  }
}
