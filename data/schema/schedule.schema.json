{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timezone",
    "items",
    "limits"
  ],
  "properties": {
    "timezone": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "cron",
          "what"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "cron": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "roles"
        ],
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "focus"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "focus": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
