{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "added",
      "added_by",
      "status",
      "area",
      "title",
      "summary",
      "source"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "added": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "added_by": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core",
          "Scoutmaster",
          "Critic",
          "Advocate",
          "Librarian",
          "Comms",
          "Gamemaster",
          "Strategy"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "confirmed",
          "reported"
        ]
      },
      "area": {
        "type": "string",
        "enum": [
          "email",
          "browser",
          "routines",
          "connectors",
          "x",
          "app",
          "billing",
          "voice",
          "coding",
          "community"
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 90
      },
      "summary": {
        "type": "string",
        "maxLength": 280
      },
      "source": {
        "type": "string",
        "pattern": "^https://"
      },
      "corrected": {
        "type": "string",
        "maxLength": 280
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
