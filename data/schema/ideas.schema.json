          "Sketch",
          "Pixel",
          "Core",
          "CEO",
          "Scoutmaster",
          "Critic",
          "Advocate",
          "Librarian",
          "Comms",
          "Gamemaster"
        ]
      },
      "problem": {
        "type": "string",
        "maxLength": 200
