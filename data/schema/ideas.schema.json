        "additionalProperties": false,
        "required": [
          "impact",
          "evidence",
          "fit",
          "effort",
          "risk",
          "reversibility"
        ],
        "properties": {
          "impact": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          "evidence": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          "fit": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          "effort": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          "risk": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          "reversibility": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4,
              5
            ]
          }
        }
      },
      "experiment": {
        "type": "string",
        "maxLength": 280
      },
      "experiment_result": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "pass",
          "fail",
          null
        ]
      },
      "librarian_checked": {
        "type": "boolean"
      },
      "stale": {
        "type": "boolean"
      },
      "fresh_until": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "challenge": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "by",
          "recommendation",
          "summary"
        ],
        "properties": {
          "by": {
            "type": "string"
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "proceed",
              "investigate",
              "reject"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 400
          }
        }
      },
      "short_title": {
        "type": "string",
        "maxLength": 40
      }
