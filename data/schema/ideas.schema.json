{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "by",
      "problem",
      "helps",
      "effort",
      "builder",
      "state",
      "comments"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "by": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
