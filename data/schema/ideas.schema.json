          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core",
          "Scoutmaster",
          "Critic",
          "Advocate",
          "Librarian",
          "Comms",
          "Gamemaster"
        ]
      },
      "state": {
        "type": "string",
        "enum": [
          "pitched",
          "yes",
          "no",
          "later",
          "vetoed",
          "needs-ceo",
          "shipped",
          "advised"
        ]
      },
      "comments": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "role",
            "stance",
            "text"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "role": {
              "type": "string",
              "enum": [
                "Scout",
                "Verify",
                "Privacy",
                "Publish",
                "Advisor",
                "Polish",
                "Coordinator",
                "Trial",
                "Sweep",
                "Atlas",
                "Analyst",
                "Forge",
                "Lens",
                "Shield",
                "Sketch",
                "Pixel",
                "Core",
                "Scoutmaster",
                "Critic",
                "Advocate",
                "Librarian",
                "Comms",
                "Gamemaster"
              ]
            },
            "stance": {
              "type": "string",
              "enum": [
                "support",
                "concern",
                "oppose"
              ]
            },
            "strong": {
              "type": "boolean"
            },
            "text": {
              "type": "string",
              "maxLength": 280
            }
          }
        }
      },
      "decided": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "decided_by": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core",
          "CEO",
          "Scoutmaster",
          "Critic",
          "Advocate",
          "Librarian",
          "Comms",
          "Gamemaster"
        ]
      },
      "reason": {
        "type": "string",
        "maxLength": 400
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 200
        }
      },
      "repitch_of": {
        "type": "string"
      },
      "ref": {
        "type": "string"
      },
      "source": {
        "type": "string",
        "enum": [
          "team",
          "ceo"
