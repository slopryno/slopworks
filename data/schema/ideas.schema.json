          "no",
          "smaller",
          null
        ]
      },
      "pros": {
        "type": "string",
        "maxLength": 400
      },
      "cons": {
        "type": "string",
        "maxLength": 400
      },
      "concerns": {
        "type": "string",
        "maxLength": 400
      },
      "target_sprint": {
        "type": "string",
        "maxLength": 20
      },
      "objections": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 280
        }
      },
      "shipped": {
        "type": "string",
        "maxLength": 200
      },
      "outcome_met": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "acceptance_criteria": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 200
        }
      },
      "acceptance_verified_by": {
        "type": "string"
      },
