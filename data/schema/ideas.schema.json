{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "by",
      "problem",
      "helps",
      "effort",
      "builder",
      "state",
      "comments"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "by": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core",
          "CEO"
        ]
      },
      "problem": {
        "type": "string",
        "maxLength": 200
      },
      "helps": {
        "type": "string",
        "maxLength": 160
      },
      "effort": {
        "type": "string",
        "enum": [
          "S",
          "M",
          "L"
        ]
      },
      "builder": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core"
        ]
      },
      "state": {
        "type": "string",
        "enum": [
          "pitched",
          "yes",
          "no",
          "later",
          "vetoed",
          "needs-ceo",
          "shipped",
          "advised"
        ]
      },
      "comments": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "role",
            "stance",
            "text"
          ],
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "role": {
              "type": "string",
              "enum": [
                "Scout",
                "Verify",
                "Privacy",
                "Publish",
                "Advisor",
                "Polish",
                "Coordinator",
                "Trial",
                "Sweep",
                "Atlas",
                "Analyst",
                "Forge",
                "Lens",
                "Shield",
                "Sketch",
                "Pixel",
                "Core"
              ]
            },
            "stance": {
              "type": "string",
              "enum": [
                "support",
                "concern",
                "oppose"
              ]
            },
            "strong": {
              "type": "boolean"
            },
            "text": {
              "type": "string",
              "maxLength": 280
            }
          }
        }
      },
      "decided": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "decided_by": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core",
          "CEO"
        ]
      },
      "reason": {
        "type": "string",
        "maxLength": 400
      },
      "evidence": {
        "type": "string",
        "maxLength": 280
      },
      "repitch_of": {
        "type": "string"
      },
      "ref": {
        "type": "string"
      },
      "source": {
        "type": "string",
        "enum": [
          "team",
          "ceo"
        ]
      },
      "recommendation": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "yes",
          "no",
          "smaller",
          null
        ]
      },
      "pros": {
        "type": "string",
        "maxLength": 400
      },
      "cons": {
        "type": "string",
        "maxLength": 400
      },
      "concerns": {
        "type": "string",
        "maxLength": 400
      },
      "target_sprint": {
        "type": "string",
        "maxLength": 20
      }
    }
  }
}
