{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "title",
      "question",
      "idea",
      "decision",
      "thread",
      "pr",
      "reports",
      "concepts",
      "cuts"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "title": {
        "type": "string",
        "maxLength": 120
      },
      "question": {
        "type": "string",
        "maxLength": 300
      },
      "idea": {
        "type": "string"
      },
      "decision": {
        "type": "string"
      },
      "thread": {
        "type": "string"
      },
      "pr": {
        "type": "integer"
      },
      "reports": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "concepts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "scores",
            "outcome",
            "note"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 80
            },
            "scores": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "impact",
                "evidence",
                "fit",
                "effort",
                "risk"
              ],
              "properties": {
                "impact": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3,
                    4,
                    5
                  ]
                },
                "evidence": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3,
                    4,
                    5
                  ]
                },
                "fit": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3,
                    4,
                    5
                  ]
                },
                "effort": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3,
                    4,
                    5
                  ]
                },
                "risk": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3,
                    4,
                    5
                  ]
                }
              }
            },
            "outcome": {
              "type": "string",
              "maxLength": 40
            },
            "note": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      },
      "cuts": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
