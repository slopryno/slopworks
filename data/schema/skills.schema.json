{
  "type": "object",
  "additionalProperties": false,
  "required": ["_note", "trained", "sources", "skills", "skipped", "tracks"],
  "properties": {
    "_note": {"type": "string", "pattern": "\\S"},
    "trained": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sources": {"type": "object"},
    "skills": {"type": "object"},
    "skipped": {"type": "object"},
    "tracks": {"type": "object"}
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "path", "author", "version", "commit", "license", "license_file", "skills_upstream"],
      "properties": {
        "repo": {"type": "string", "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+$"},
        "path": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "author": {"type": "string", "pattern": "\\S", "maxLength": 80},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string", "enum": ["MIT"]},
        "license_file": {"type": "string", "enum": ["LICENSE"]},
        "skills_upstream": {"type": "integer"}
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256", "does", "adapted"],
      "properties": {
        "source": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "does": {"type": "string", "pattern": "\\S", "maxLength": 200},
        "adapted": {"type": "string", "pattern": "\\S", "maxLength": 240}
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "why"],
      "properties": {
        "source": {"type": "string"},
        "why": {"type": "string", "pattern": "\\S", "maxLength": 160}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "asked", "trained", "roles", "note", "sources", "modules", "exercises"],
      "properties": {
        "title": {"type": "string", "pattern": "\\S", "maxLength": 40},
        "asked": {"type": "string", "pattern": "^Ryno, \\d{4}-\\d{2}-\\d{2} \\d{1,2}:\\d{2} [AP]M ET: \".+\"$", "maxLength": 240},
        "trained": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "roles": {"type": "array", "items": {"type": "string", "enum": ["Polish", "Gamemaster", "Advisor", "Advocate", "Analyst", "Assistant", "Atlas", "Comms", "Coordinator", "Critic", "Forge", "Lens", "Librarian", "Scoutmaster", "Shield", "Sketch", "Strategy", "Sweep", "Trial"]}},
        "note": {"type": "string", "pattern": "\\S", "maxLength": 240},
        "sources": {"type": "object"},
        "modules": {"type": "array"},
        "exercises": {"type": "object"}
      }
    },
    "track_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "title", "url"],
      "properties": {
        "publisher": {"type": "string", "pattern": "\\S", "maxLength": 40},
        "title": {"type": "string", "pattern": "\\S", "maxLength": 90},
        "url": {"type": "string", "pattern": "^https://"}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "roles", "principle", "slopworks", "practice", "sources", "check"],
      "properties": {
        "id": {"type": "string", "pattern": "^m\\d+$"},
        "title": {"type": "string", "pattern": "\\S", "maxLength": 40},
        "roles": {"type": "array", "items": {"type": "string", "enum": ["Polish", "Gamemaster", "Advisor", "Advocate", "Analyst", "Assistant", "Atlas", "Comms", "Coordinator", "Critic", "Forge", "Lens", "Librarian", "Scoutmaster", "Shield", "Sketch", "Strategy", "Sweep", "Trial"]}},
        "principle": {"type": "string", "pattern": "\\S", "maxLength": 200},
        "slopworks": {"type": "string", "pattern": "\\S", "maxLength": 200},
        "practice": {"type": "string", "pattern": "\\S", "maxLength": 120},
        "sources": {"type": "array", "items": {"type": "string"}},
        "skills": {"type": "array", "items": {"type": "string"}},
        "check": {"type": "object", "additionalProperties": false, "required": ["state", "where"], "properties": {"state": {"type": "string", "enum": ["enforced", "proposed"]}, "where": {"type": "string", "pattern": "\\S", "maxLength": 200}}}
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "width", "site", "pages", "method", "grade", "findings"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "width": {"type": "integer", "enum": [320, 360, 390, 430, 768, 1024, 1440]},
        "site": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "pages": {"type": "integer"},
        "method": {"type": "string", "pattern": "\\S", "maxLength": 200},
        "grade": {"type": "object", "additionalProperties": false, "required": ["state", "by"], "properties": {"state": {"type": "string", "enum": ["pending", "pass", "redo"]}, "by": {"type": "string", "enum": ["Polish", "Gamemaster", "Advisor", "Advocate", "Analyst", "Assistant", "Atlas", "Comms", "Coordinator", "Critic", "Forge", "Lens", "Librarian", "Scoutmaster", "Shield", "Sketch", "Strategy", "Sweep", "Trial"]}}},
        "findings": {"type": "array"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "kind", "what", "evidence", "next"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]\\d+$"},
        "module": {"type": "string", "pattern": "^m\\d+$"},
        "kind": {"type": "string", "enum": ["defect", "risk", "pass"]},
        "what": {"type": "string", "pattern": "\\S", "maxLength": 200},
        "evidence": {"type": "string", "pattern": "\\S", "maxLength": 160},
        "next": {"type": "string", "pattern": "\\S", "maxLength": 80}
      }
    }
  }
}
