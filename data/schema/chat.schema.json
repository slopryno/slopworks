{
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "date",
      "from",
      "to",
      "text"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "from": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core"
        ]
      },
      "to": {
        "type": "string",
        "enum": [
          "Scout",
          "Verify",
          "Privacy",
          "Publish",
          "Advisor",
          "Polish",
          "Coordinator",
          "Trial",
          "Sweep",
          "Atlas",
          "Analyst",
          "Forge",
          "Lens",
          "Shield",
          "Sketch",
          "Pixel",
          "Core",
          "Team"
        ]
      },
      "text": {
        "type": "string",
        "maxLength": 280
      },
      "ref": {
        "type": "string",
        "pattern": "^https://"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
